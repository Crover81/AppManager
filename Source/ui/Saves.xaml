<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AppManager;assembly=AppManager">

    <!-- ================================================================ SALVATAGGI DI UN GIOCO -->
    <DataTemplate DataType="{x:Type local:SavesDialogViewModel}">
        <Border Style="{StaticResource Card}" Width="800" MaxHeight="780" Background="{StaticResource Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- intestazione -->
                <Grid Margin="24,20,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,16,0" VerticalAlignment="Center" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                        <!-- copertina verticale o, se manca, l'icona dell'eseguibile -->
                        <Border Width="40" Height="60" CornerRadius="7" Visibility="{Binding HasPortrait, Converter={StaticResource Vis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Image Width="44" Height="44" Source="{Binding Cover}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasSquareIcon, Converter={StaticResource Vis}}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip="Chiudi (Esc)"/>
                </Grid>

                <!-- corpo -->
                <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Background="{StaticResource Bg}">
                    <Grid>
                        <!-- ricerca delle cartelle -->
                        <StackPanel Margin="40,56" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
                            <local:Spinner/>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Dim}" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="600"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,16,18" Visibility="{Binding ShowContent, Converter={StaticResource Vis}}">
                            <StackPanel Margin="0,0,8,0">
                                <!-- avvisi: gioco aperto, Steam Cloud -->
                                <Border Padding="14,10" CornerRadius="10" Background="{StaticResource WarningSoft}" Margin="0,0,0,16"
                                        Visibility="{Binding HasWarning, Converter={StaticResource Vis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Warning}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>

                                <!-- nessuna cartella trovata -->
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,16" Visibility="{Binding HasNoLocations, Converter={StaticResource Vis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Command="{Binding AddLocationCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Foreground="White"/>
                                                <TextBlock Text="Aggiungi cartella" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="Non ho trovato i salvataggi di questo gioco" Style="{StaticResource H3}"/>
                                            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                                                       Text="Aggiungi la cartella dei salvataggi del gioco. Di solito è in Documenti\My Games, Giochi salvati o AppData."/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- ============ PROFILI ============ -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="PROFILI" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveProfileText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Profiles}" Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Dot" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Surface3}">
                                                        <TextBlock x:Name="Letter" Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                                    </Border>
                                                    <!-- nome (o casella per rinominarlo) -->
                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenaming, Converter={StaticResource NotVis}}">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" MaxWidth="330"/>
                                                            <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}" Margin="8,0,0,0"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                                <TextBlock Text="In uso" FontSize="11.5" Foreground="{StaticResource Success}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenaming, Converter={StaticResource Vis}}">
                                                            <TextBox Style="{StaticResource Input}" Width="240" Tag="Nome del profilo" MaxLength="40"
                                                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE73E;" Margin="6,0,0,0" Command="{Binding ConfirmRenameCommand}" ToolTip="Conferma"/>
                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Command="{Binding CancelRenameCommand}" ToolTip="Annulla"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource PrimaryBtn}" Content="Usa questo" Padding="14,7" Command="{Binding UseCommand}"
                                                                Visibility="{Binding IsActive, Converter={StaticResource NotVis}}"
                                                                ToolTip="Metti da parte i salvataggi attuali e usa quelli di questo profilo"/>
                                                        <Button Style="{StaticResource IconBtn}" Content="&#xE70F;" Margin="6,0,0,0" Command="{Binding RenameCommand}" ToolTip="Rinomina"/>
                                                        <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Command="{Binding DeleteCommand}" ToolTip="Elimina il profilo (va nel Cestino)"
                                                                Visibility="{Binding IsActive, Converter={StaticResource NotVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Success}"/>
                                                    <Setter TargetName="Dot" Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                    <Setter TargetName="Letter" Property="Foreground" Value="{StaticResource Success}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- nuova partita / nuovo profilo -->
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,22">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Command="{Binding NewGameCommand}" Margin="10,0,0,0"
                                                    ToolTip="Metti da parte i salvataggi attuali e inizia da zero con un nuovo profilo">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Foreground="White"/>
                                                    <TextBlock Text="Nuova partita" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBox Style="{StaticResource Input}" Tag="Nome del nuovo profilo (es. il nome del giocatore)" MaxLength="40"
                                                     Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                                                   Text="I salvataggi attuali restano nel profilo in uso. Il gioco riparte da zero con un nuovo profilo e puoi tornare a quello precedente quando vuoi."/>
                                    </StackPanel>
                                </Border>

                                <!-- ============ BACKUP ============ -->
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostBtn}" Content="Tutti i backup" Padding="10,6" Command="{Binding AllBackupsCommand}"/>
                                        <Button Style="{StaticResource Btn}" Command="{Binding BackupCommand}" Margin="6,0,0,0" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="12"/>
                                                <TextBlock Text="Crea backup ora" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="BACKUP DEI SALVATAGGI" Style="{StaticResource SectionLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Nessun backup dei salvataggi. Premi «Crea backup ora» per crearne uno." Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,22" Visibility="{Binding HasBackups, Converter={StaticResource NotVis}}"/>
                                <ItemsControl ItemsSource="{Binding Backups}" Margin="0,0,0,14" Visibility="{Binding HasBackups, Converter={StaticResource Vis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Btn}" Content="Ripristina" Padding="12,6" Command="{Binding RestoreCommand}"
                                                                ToolTip="Sostituisci i salvataggi attuali con questi (prima viene fatto un backup automatico)"/>
                                                        <Button Style="{StaticResource IconBtn}" Content="&#xE838;" Margin="6,0,0,0" Command="{Binding RevealCommand}" ToolTip="Mostra il file del backup"/>
                                                    </StackPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Success}" Margin="0,0,12,0"/>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DateText}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                            <Run Text="{Binding ReasonLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ============ CARTELLE ============ -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Padding="10,6" Command="{Binding AddLocationCommand}"
                                            ToolTip="Aggiungi una cartella di salvataggi che AppManager non ha trovato da solo">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11"/>
                                            <TextBlock Text="Aggiungi cartella" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="CARTELLE GESTITE" Style="{StaticResource SectionLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Locations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="2,9">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconBtn}" Content="&#xE838;" Command="{Binding RevealCommand}" ToolTip="Mostra in Esplora risorse"/>
                                                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Command="{Binding RemoveCommand}" ToolTip="Non gestire più questa cartella (i file restano)"/>
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" MinWidth="92" VerticalAlignment="Top" Margin="0,1,12,0"
                                                            Background="{Binding KindColor, Converter={StaticResource Brush}, ConverterParameter=0.14}">
                                                        <TextBlock Text="{Binding KindLabel}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{Binding KindColor, Converter={StaticResource Brush}}"/>
                                                    </Border>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox Content="Includi anche le impostazioni del gioco (grafica, comandi…): ogni profilo avrà le sue" Margin="0,12,0,0"
                                          IsChecked="{Binding IncludeSettings}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- operazione in corso: tutto il corpo è bloccato -->
                        <Grid Background="{StaticResource BusyOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                                <local:Spinner/>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Dim}" Margin="0,16,0,0" TextAlignment="Center"/>
                                <TextBlock Text="Non chiudere AppManager finché non ha finito." Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- piede -->
                <DockPanel Grid.Row="2" Margin="24,14,24,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Chiudi" Padding="18,8" Command="{Binding CloseCommand}"/>
                    <Button Style="{StaticResource GhostBtn}" HorizontalAlignment="Left" Padding="10,6" Command="{Binding OpenVaultCommand}"
                            ToolTip="Cartella dei profili non in uso" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="12"/>
                            <TextBlock Text="Apri il deposito dei profili" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
