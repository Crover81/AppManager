<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppManager" Width="396" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize" WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" Foreground="{StaticResource Text}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- il margine lascia spazio all'ombra -->
    <Grid>
        <Border Margin="12" CornerRadius="12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,14,10,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" Y="0"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Top" Margin="0,2,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6F9BFF" Offset="0"/>
                            <GradientStop Color="#7B5CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE74C;" Style="{StaticResource Glyph}" Foreground="White" FontSize="15"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="AppManager" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" FontSize="13" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasActions, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource PrimaryBtn}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GhostBtn}" Content="Ignora" Command="{Binding IgnoreCommand}" Padding="12,7"
                                ToolTip="Nasconde l'avviso: la voce resta nella cronologia, dove puoi rivederla quando vuoi"/>
                    </WrapPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" Width="26" Height="26" FontSize="10" VerticalAlignment="Top"
                        Margin="6,-4,0,0" Command="{Binding CloseCommand}" ToolTip="Chiudi"/>
            </Grid>
        </Border>
    </Grid>
</Window>
