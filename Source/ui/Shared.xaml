<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AppManager;assembly=AppManager">

    <!-- Riga di un elemento residuo: casella, icona, percorso, motivo, affidabilità, dimensione, apri -->
    <DataTemplate x:Key="ItemRow">
        <Grid Margin="0,4" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource TextFaint}"
                       VerticalAlignment="Top" Margin="10,3,10,0"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}"/>
                <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Visibility="{Binding Detail, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <Border Grid.Column="3" Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="12,0,0,0"
                    Background="{Binding ConfidenceColor, Converter={StaticResource Brush}, ConverterParameter=0.14}">
                <TextBlock Text="{Binding ConfidenceLabel}" FontSize="11" Foreground="{Binding ConfidenceColor, Converter={StaticResource Brush}}"/>
            </Border>
            <TextBlock Grid.Column="4" Text="{Binding SizeText}" Foreground="{StaticResource TextDim}" Width="72" TextAlignment="Right"
                       VerticalAlignment="Top" Margin="6,1,0,0"/>
            <Button Grid.Column="5" Style="{StaticResource IconBtn}" Content="&#xE8A7;" Width="28" Height="26" FontSize="12"
                    Command="{Binding OpenCommand}" ToolTip="{Binding OpenTip}" VerticalAlignment="Top" Margin="6,-2,0,0"/>
        </Grid>
    </DataTemplate>

    <!-- Scheda di un gruppo di elementi (categoria o gioco orfano) -->
    <DataTemplate x:Key="GroupCard">
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="14,12,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Margin="12,0,12,0" Width="36" Height="36">
                        <Border CornerRadius="8" Background="{StaticResource Surface2}" Visibility="{Binding HasImage, Converter={StaticResource NotVis}}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Foreground="{StaticResource TextDim}"/>
                        </Border>
                        <Border CornerRadius="6" Visibility="{Binding HasImage, Converter={StaticResource Vis}}" Width="30" Height="45" Margin="0,-6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Visibility="{Binding Source, Converter={StaticResource Vis}}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource LinkBtn}" Content="{Binding LinkText}" FontSize="12" Margin="0,0,14,0"
                            VerticalAlignment="Center" Command="{Binding OpenLinkCommand}" Visibility="{Binding Link, Converter={StaticResource Vis}}"
                            ToolTip="Apre SteamDB nel browser per scoprire il nome del gioco"/>
                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="5" Command="{Binding ToggleCommand}" ToolTip="Mostra o nascondi i dettagli">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                <Setter Property="Content" Value="&#xE70D;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Content" Value="&#xE70E;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8,10,10"
                        Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}"/>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Icona del programma (o le sue iniziali, se non ha un'icona) -->
    <DataTemplate x:Key="ProgramIcon">
        <Grid>
            <Border CornerRadius="8" Margin="-2" Background="{Binding IconBackdrop, Converter={StaticResource Brush}}"
                    Visibility="{Binding IconBackdrop, Converter={StaticResource Vis}}"/>
            <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border CornerRadius="8" Background="{Binding TypeColor, Converter={StaticResource Brush}, ConverterParameter=0.16}"
                    Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}">
                <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding TypeColor, Converter={StaticResource Brush}}"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Copertina del gioco (immagine, icona o iniziali) -->
    <DataTemplate x:Key="GameArt">
        <Grid>
            <Border CornerRadius="7" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Border CornerRadius="7" Background="{Binding LauncherColor, Converter={StaticResource Brush}, ConverterParameter=0.16}"
                    Visibility="{Binding HasCover, Converter={StaticResource NotVis}}">
                <Grid>
                    <Image Source="{Binding Icon}" Margin="6" MaxWidth="56" MaxHeight="56" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding LauncherColor, Converter={StaticResource Brush}}"
                               Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
