<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AppManager;assembly=AppManager">

    <!-- Riquadro con un numero (Panoramica) -->
    <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Azione rapida della Panoramica -->
    <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ PANORAMICA -->
    <DataTemplate DataType="{x:Type local:OverviewPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26,30,26" MaxWidth="820">
                <TextBlock Text="Panoramica" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                <TextBlock Text="Il PC a colpo d'occhio: cosa occupa spazio e cosa è cambiato." Style="{StaticResource Dim}" Margin="0,0,0,20"/>

                <!-- questo PC -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,18">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top" Background="{StaticResource AccentSoft}">
                            <TextBlock Text="&#xE977;" Style="{StaticResource Glyph}" Foreground="{StaticResource Accent}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PcName}" Style="{StaticResource H3}"/>
                            <!-- lo spazio resta riservato: la riga arriva appena letto il registro eventi e la pagina non deve spostarsi -->
                            <TextBlock Text="{Binding PcUptime}" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                       Visibility="{Binding PcUptime, Converter={StaticResource VisKeep}}"/>
                            <TextBlock Text="{Binding PcAge}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                                       Visibility="{Binding PcAge, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- numeri -->
                <UniformGrid Rows="1" Margin="-5,0,-5,18">
                    <Button Style="{StaticResource Tile}" Margin="5,0" Command="{Binding GoCommand}" CommandParameter="programs">
                        <StackPanel>
                            <TextBlock Text="Programmi" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ProgramsText}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding ProgramsDetail}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Margin="5,0" Command="{Binding GoCommand}" CommandParameter="games">
                        <StackPanel>
                            <TextBlock Text="Giochi" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding GamesText}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding GamesDetail}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Margin="5,0" Command="{Binding GoCommand}" CommandParameter="backups">
                        <StackPanel>
                            <TextBlock Text="Backup" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding BackupsText}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding BackupsDetail}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tile}" Margin="5,0" Command="{Binding GoCommand}" CommandParameter="settings"
                            ToolTip="Spazio occupato dalla cartella Dati. Viene tenuta in ordine in automatico.">
                        <StackPanel>
                            <TextBlock Text="AppManager" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ResourcesText}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding ResourcesDetail}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- cosa è cambiato -->
                <StackPanel Visibility="{Binding HasChanges, Converter={StaticResource Vis}}">
                    <TextBlock Text="COSA È CAMBIATO" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,18">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE711;" Width="28" Height="28" VerticalAlignment="Top"
                                    Command="{Binding DismissChangesCommand}" ToolTip="Nascondi"/>
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel Visibility="{Binding HasAdded, Converter={StaticResource Vis}}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding AddedTitle}" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                    <ItemsControl ItemsSource="{Binding Added}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasRemoved, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding RemovedTitle}" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                                    <ItemsControl ItemsSource="{Binding Removed}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- azioni rapide -->
                <TextBlock Text="AZIONI RAPIDE" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="-5,0,-5,14">
                    <Button Style="{StaticResource QuickAction}" Margin="5,0,5,8" Command="{Binding GoCommand}" CommandParameter="program-orphans">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Cerca i residui" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickAction}" Margin="5,0,5,8" Command="{Binding GoCommand}" CommandParameter="startup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Controlla l'avvio automatico" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickAction}" Margin="5,0,5,8" Command="{Binding GoCommand}" CommandParameter="logs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Pulisci i log del PC" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickAction}" Margin="5,0,5,8" Command="{Binding ExportCommand}"
                            ToolTip="Salva in un file CSV i giochi e i programmi trovati">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Esporta l'elenco" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- spazio -->
                <TextBlock Text="DISCHI" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Card}" Padding="18,6" Margin="0,0,0,18">
                    <Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10" Visibility="{Binding IsLoadingDisks, Converter={StaticResource Vis}}">
                        <local:Spinner Width="22" Height="22"/>
                        <TextBlock Text="Leggo i dischi…" Style="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Foreground="{StaticResource TextDim}" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Margin="0,6,0,0" Value="{Binding Used, Mode=OneWay}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </Border>

                <StackPanel Visibility="{Binding ShowTopSection, Converter={StaticResource Vis}}">
                    <TextBlock Text="CHI OCCUPA PIÙ SPAZIO" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}" Padding="8,6">
                        <Grid>
                        <StackPanel Orientation="Horizontal" Margin="10,10" Visibility="{Binding IsLoadingTopApps, Converter={StaticResource Vis}}">
                            <local:Spinner Width="22" Height="22"/>
                            <TextBlock Text="Calcolo lo spazio occupato…" Style="{StaticResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TopApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostBtn}" Command="{Binding OpenCommand}" Padding="10,7" HorizontalContentAlignment="Stretch" Foreground="{StaticResource Text}"
                                            ToolTip="Apri nella libreria">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{StaticResource TextDim}" Margin="12,0,0,0"/>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="0,0,8,0"
                                                        Background="{Binding KindColor, Converter={StaticResource Brush}, ConverterParameter=0.16}">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{Binding KindColor, Converter={StaticResource Brush}}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource Bar}" Height="4" Margin="0,6,0,0" Value="{Binding Share, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================================================================ AVVIO AUTOMATICO -->
    <DataTemplate DataType="{x:Type local:StartupPageViewModel}">
        <Grid Margin="30,26,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Margin="0,0,330,0">
                    <TextBlock Text="Avvio automatico" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SearchBox}" Width="260" Tag="Cerca…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" Width="36" Height="36" Margin="6,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Aggiorna (F5)"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="14,10" CornerRadius="10" Background="{StaticResource WarningSoft}"
                    Visibility="{Binding ShowAdminHint, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkBtn}" Content="Riavvia come amministratore" VerticalAlignment="Center"
                            Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{StaticResource Warning}" Margin="0,0,10,0"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" Text="Le voci «tutti gli utenti» si cambiano solo come amministratore."/>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="6,6">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowList, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding View}" Margin="12,2,10,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Background="{Binding IconBackdrop, Converter={StaticResource Brush}}"
                                                    Visibility="{Binding IconBackdrop, Converter={StaticResource Vis}}"/>
                                            <Border CornerRadius="8" Background="{StaticResource Surface2}" Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}">
                                                <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}" Margin="8,0,0,0"
                                                        Visibility="{Binding TargetMissing, Converter={StaticResource Vis}}" ToolTip="Il file di questa voce non esiste più. Puoi eliminarla dalla pagina Residui.">
                                                    <TextBlock Text="File mancante" FontSize="11" Foreground="{StaticResource Warning}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" ToolTip="{Binding Command}" Margin="0,1,0,0"/>
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE838;" Command="{Binding RevealCommand}" ToolTip="Mostra in Esplora risorse" Margin="0,0,12,0"/>
                                        <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                  ToolTip="Attiva o disattiva l'avvio con Windows, come in Gestione attività"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
                        <local:Spinner/>
                        <TextBlock Text="Leggo l'avvio automatico…" Style="{StaticResource Dim}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" FontSize="34" Foreground="{StaticResource TextFaint}"/>
                        <TextBlock Text="Nessun programma parte con Windows" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Nessun risultato." Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsFilteredEmpty, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Dim}" Margin="12" Foreground="{StaticResource Danger}"
                               Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,0"
                       Text="Disattivare non elimina nulla: cambia solo lo stato, come in Gestione attività. Puoi riattivare la voce quando vuoi."/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
